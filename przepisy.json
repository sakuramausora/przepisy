    {
      "id": "4dbf1042-380d-4a0e-bca9-99e30409d2cf",
      "title": "Czosnkowe curry",
      "description": "Aromatyczne danie z kurczaka w kremowym sosie z nerkowców, z wyraźną nutą czosnku i przypraw korzennych.",
      "servings": 4,
      "prepMinutes": 20,
      "cookMinutes": 25,
      "totalMinutes": 45,
      "tags": [
        "kurczak",
        "curry",
        "obiad",
        "kuchnia indyjska"
      ],
      "ingredients": [
        {
          "id": "bc57dc9c-0464-4369-a427-6543163cd483",
          "raw": "400–450 g piersi lub udek z kurczaka",
          "name": "kurczak",
          "quantity": 450,
          "unit": "g",
          "note": "pierś lub udka"
        },
        {
          "id": "1647c096-8811-416c-8de3-c671e470fed2",
          "raw": "70 g nerkowców",
          "name": "nerkowiec",
          "quantity": 70,
          "unit": "g",
          "note": ""
        },
        {
          "id": "203c64e3-c881-46df-81d4-7f82400503c3",
          "raw": "½ małej cebuli",
          "name": "cebula",
          "quantity": 0.5,
          "unit": "szt",
          "note": "mała"
        },
        {
          "id": "40176406-7674-4992-b302-9c68b58e514d",
          "raw": "5–6 ząbków czosnku",
          "name": "czosnek",
          "quantity": 6,
          "unit": "szt",
          "note": ""
        },
        {
          "id": "c5a01bca-1bf0-4d50-b5f9-242deb1520fa",
          "raw": "1 kawałek imbiru, ok. 2–3 cm",
          "name": "imbir",
          "quantity": 3,
          "unit": "cm",
          "note": ""
        },
        {
          "id": "4e0555ff-fb61-4408-b4a7-d4deba7ed243",
          "raw": "150 ml śmietanki 18% lub 30%",
          "name": "śmietanka",
          "quantity": 150,
          "unit": "ml",
          "note": "18% lub 30%"
        },
        {
          "id": "63111ee3-427e-4876-ad13-d09019ca4755",
          "raw": "100–150 ml wody",
          "name": "woda",
          "quantity": 150,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "73a22513-bdad-43d8-bf56-4464e02951f4",
          "raw": "1 łyżka ghee lub masła",
          "name": "masło klarowane",
          "quantity": 15,
          "unit": "ml",
          "note": "ghee lub masło"
        },
        {
          "id": "1145095e-13e1-4a29-a187-07e06bcefdbb",
          "raw": "1 łyżka oleju",
          "name": "olej",
          "quantity": 15,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "adaf2b2e-d10e-4ddf-86d9-f1ca02c200f4",
          "raw": "1 łyżeczka garam masala",
          "name": "garam masala",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "fa7a592c-c952-4424-8984-78d760769008",
          "raw": "1 łyżeczka mielonej kolendry",
          "name": "kolendra mielona",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "1f723044-b6f5-4444-9d06-0a63e5ccac5d",
          "raw": "½ łyżeczki kuminu",
          "name": "kumin",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "1b89cfbd-0374-442a-8fc0-6c54733e2150",
          "raw": "½ łyżeczki kurkumy",
          "name": "kurkuma",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "db6c5c32-e4df-45e2-9bab-187ba57334fb",
          "raw": "½ łyżeczki chili Kashmiri lub zwykłego chili",
          "name": "chili",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "9842a2d4-fed3-4e62-9ab9-51ffbb1353ad",
          "raw": "½ łyżeczki soli",
          "name": "sól",
          "quantity": 2.5,
          "unit": "ml",
          "note": "do smaku"
        },
        {
          "id": "540c7e6b-dc75-4bba-9dca-365be3b7cdf0",
          "raw": "1 łyżeczka soku z cytryny",
          "name": "sok z cytryny",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "39d09e2f-c187-4766-87e7-51fd353afc28",
          "raw": "2–3 strączki kardamonu",
          "name": "kardamon",
          "quantity": 3,
          "unit": "szt",
          "note": "opcjonalnie"
        },
        {
          "id": "357dcb6f-d90c-4f41-9c4f-ca1320202006",
          "raw": "świeża kolendra do podania",
          "name": "kolendra świeża",
          "quantity": 0,
          "unit": "szt",
          "note": "opcjonalnie"
        }
      ],
      "steps": [
        {
          "id": "f92b6ad2-d3d0-4e18-a1a9-89e1d257522e",
          "text": "Zalej nerkowce gorącą wodą i odstaw na 15-20 minut. Odcedź, dodaj 50 ml wody i zblenduj na gładką pastę.",
          "durationMinutes": 20
        },
        {
          "id": "7b645648-c4c9-498c-80c8-ff6b9fd8abe7",
          "text": "Kurczaka pokrój w kawałki, wymieszaj z częścią garam masala, kuminu, solą i olejem. Obsmaż na patelni przez kilka minut i zdejmij na talerz.",
          "durationMinutes": 5
        },
        {
          "id": "4bd3068e-e910-4735-890c-c93d5fd67750",
          "text": "Na tej samej patelni rozgrzej masło i resztę oleju, podsmaż drobno posiekaną cebulę przez 2-3 minuty.",
          "durationMinutes": 3
        },
        {
          "id": "8852f897-22be-46a3-8f3d-9c3e36a728f0",
          "text": "Dodaj starty imbir i większość posiekanego czosnku, smaż 1 minutę.",
          "durationMinutes": 1
        },
        {
          "id": "5766cad7-3fdd-493d-8869-88440b6a0ab0",
          "text": "Dodaj pozostałe przyprawy (kumin, kolendrę, kurkumę, chili, resztę garam masala, kardamon) i smaż 30 sekund.",
          "durationMinutes": 1
        },
        {
          "id": "96ed4438-9d25-4183-b3e1-ae01419066a4",
          "text": "Dodaj pastę z nerkowców i 100 ml wody, wymieszaj. Włóż kurczaka i duś pod przykryciem 8-10 minut.",
          "durationMinutes": 10
        },
        {
          "id": "72296de6-ed66-447a-b104-0b53cb37b581",
          "text": "Dodaj śmietankę oraz ostatni ząbek czosnku (drobno starty), podgrzewaj 2-3 minuty bez gotowania.",
          "durationMinutes": 3
        },
        {
          "id": "9e9efe7d-9e89-4642-b661-99a002fa2d67",
          "text": "Na koniec dodaj sok z cytryny i dopraw solą do smaku.",
          "durationMinutes": 1
        }
      ],
      "warnings": [
        "The recipe is complete and clearly described in the provided image."
      ],
