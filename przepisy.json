  "recipes": [
    {
      "id": "b9bc8ff2-9c8e-42ec-bb01-7199d9ee4f5e",
      "title": "Kremowe curry z kurczakiem i czosnkiem",
      "description": "Aromatyczne danie z kurczakiem w kremowym sosie na bazie nerkowców i dużej ilości czosnku.",
      "servings": 4,
      "prepMinutes": 20,
      "cookMinutes": 20,
      "totalMinutes": 40,
      "tags": [
        "kurczak",
        "curry",
        "kuchnia indyjska",
        "obiad"
      ],
      "ingredients": [
        {
          "id": "902dce36-bf39-405d-8ad6-af3e8c92ae9d",
          "raw": "400-450 g piersi lub udek z kurczaka",
          "name": "kurczak",
          "quantity": 425,
          "unit": "g",
          "note": "pierś lub udek"
        },
        {
          "id": "09b4fd2c-b098-42d9-a6ac-9e5283861015",
          "raw": "70 g nerkowców",
          "name": "nerkowiec",
          "quantity": 70,
          "unit": "g",
          "note": ""
        },
        {
          "id": "02118064-a1fc-430e-9296-d4698429b9f7",
          "raw": "½ małej cebuli",
          "name": "cebula",
          "quantity": 0.5,
          "unit": "szt",
          "note": "mała"
        },
        {
          "id": "bc30617a-5d0e-460b-be34-60e702273de3",
          "raw": "5-6 ząbków czosnku",
          "name": "czosnek",
          "quantity": 5.5,
          "unit": "szt",
          "note": ""
        },
        {
          "id": "30ad0dc3-b810-4de4-a146-05b310d15ba3",
          "raw": "1 kawałek imbiru, ok. 2-3 cm",
          "name": "imbir",
          "quantity": 2.5,
          "unit": "cm",
          "note": ""
        },
        {
          "id": "96352b6e-91e2-415a-acf9-41c33f113079",
          "raw": "150 ml śmietanki 18% lub 30%",
          "name": "śmietanka",
          "quantity": 150,
          "unit": "ml",
          "note": "18% lub 30%"
        },
        {
          "id": "4c637ca4-ca2e-48f6-9459-009655462570",
          "raw": "100-150 ml wody",
          "name": "woda",
          "quantity": 125,
          "unit": "ml",
          "note": "do sosu"
        },
        {
          "id": "e7071f15-fb96-4c1c-a583-67ce482182e7",
          "raw": "1 łyżka ghee lub masła",
          "name": "masło klarowane",
          "quantity": 15,
          "unit": "ml",
          "note": "ghee lub masło"
        },
        {
          "id": "2eaadf1b-35f6-4354-b252-5f5e424325b5",
          "raw": "1 łyżka oleju",
          "name": "olej",
          "quantity": 15,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "be6d21e3-1825-4e91-8dbf-2669fbca07f7",
          "raw": "1 łyżeczka garam masala",
          "name": "garam masala",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "744f6298-4d04-45f3-b9d5-049aa2d0f096",
          "raw": "1 łyżeczka mielonej kolendry",
          "name": "kolendra mielona",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "3889d31b-3b30-4faa-b345-b58e13f2f14c",
          "raw": "½ łyżeczki kuminu",
          "name": "kumin",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "26752ff5-3116-4354-8adf-e9dfa68a0c54",
          "raw": "½ łyżeczki kurkumy",
          "name": "kurkuma",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "b8ad15a1-c8c7-422f-ba00-ad246a0eaa81",
          "raw": "½ łyżeczki chili Kashmiri lub zwykłego chili",
          "name": "chili",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "d8e830f4-17cf-4579-9705-586c3ceadd2c",
          "raw": "½ łyżeczki soli, potem do smaku",
          "name": "sól",
          "quantity": 2.5,
          "unit": "ml",
          "note": "do smaku"
        },
        {
          "id": "a06223c6-f71e-40fb-ab63-03c399336034",
          "raw": "1 łyżeczka soku z cytryny",
          "name": "sok z cytryny",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "9462032c-a8b9-43f6-a1a1-84cfd728d413",
          "raw": "opcjonalnie: 2-3 strączki kardamonu",
          "name": "kardamon",
          "quantity": 2.5,
          "unit": "szt",
          "note": "opcjonalnie"
        },
        {
          "id": "3a996e54-2e53-448b-9f73-79fd11964d8f",
          "raw": "opcjonalnie: świeża kolendra do podania",
          "name": "kolendra świeża",
          "quantity": 0,
          "unit": "szt",
          "note": "do podania"
        }
      ],
      "steps": [
        {
          "id": "d94787c1-e51c-48ca-82f3-5eb066c1c359",
          "text": "Zalej nerkowce gorącą wodą i zostaw na 15-20 minut. Odcedź, dodaj około 50 ml wody i zblenduj na gładką pastę.",
          "durationMinutes": 20
        },
        {
          "id": "bf6f4fbb-057b-4d65-9948-ca77a9c0130b",
          "text": "Kurczaka pokrój w kawałki i wymieszaj z częścią garam masala, kuminu, soli i oleju. Rozgrzej patelnię i mocno obsmaż kurczaka przez kilka minut, a następnie zdejmij go na talerz.",
          "durationMinutes": 5
        },
        {
          "id": "a5d1b102-e528-42fe-8960-f5f5366e0060",
          "text": "Na tej samej patelni rozgrzej masło/ghee z resztą oleju. Dodaj drobno posiekaną cebulę i smaż 2-3 minuty. Dodaj starty imbir oraz posiekany czosnek i smaż przez 30-60 sekund.",
          "durationMinutes": 4
        },
        {
          "id": "e6f0b8dc-5d87-4b77-9719-ed3934b282c8",
          "text": "Dodaj pozostałe przyprawy (kumin, kolendrę, kurkumę, chili, resztę garam masala, kardamon) i smaż 20-30 sekund, aż zaczną pachnieć.",
          "durationMinutes": 1
        },
        {
          "id": "c573b8d4-b5df-420b-94bb-984d2a18afc2",
          "text": "Dodaj pastę z nerkowców i około 100 ml wody. Wymieszaj, dodaj kurczaka i duś pod przykryciem 8-10 minut.",
          "durationMinutes": 10
        },
        {
          "id": "77980212-e5eb-4fa4-b5f9-7122ef6b1e83",
          "text": "Dodaj śmietankę oraz ostatni ząbek czosnku starty na drobno. Podgrzewaj 2-3 minuty bez agresywnego gotowania. Na koniec dodaj sok z cytryny i dopraw solą.",
          "durationMinutes": 3
        }
      ],
      "warnings": [
        "The recipe is complete and clearly described in the provided image."
      ],
      "source": null,
      "sourceType": "image",
      "createdAt": "2026-10-03T22:54:38.100Z",
      "updatedAt": "2026-10-03T22:54:38.100Z"
    },
    {
      "id": "26e106fe-8382-42fd-9355-6f9ddac3f2f7",
      "title": "Paratha (indyjski chlebek)",
      "description": "Chrupiące i warstwowe indyjskie chlebki, które świetnie smakują z curry, gulaszem lub jako dodatek do śniadania.",
      "servings": 8,
      "prepMinutes": 40,
      "cookMinutes": 20,
      "totalMinutes": 60,
      "tags": [
        "wegetariańskie",
        "chleb",
        "indyjskie",
        "śniadanie"
      ],
      "ingredients": [
        {
          "id": "1e638a46-77c4-4b5f-a318-ad7f57b45091",
          "raw": "2½ cups (300 g) wheat flour",
          "name": "mąka pszenna",
          "quantity": 625,
          "unit": "ml",
          "note": "można użyć mąki pełnoziarnistej lub uniwersalnej"
        },
        {
          "id": "d7dc9cf5-c47b-4491-b2c2-deda986ae38f",
          "raw": "½ teaspoon salt",
          "name": "sól",
          "quantity": 2.5,
          "unit": "ml",
          "note": "opcjonalnie"
        },
        {
          "id": "dd930d97-0152-4978-8102-edd20229bc16",
          "raw": "2 tsps fine sugar",
          "name": "cukier",
          "quantity": 10,
          "unit": "ml",
          "note": "opcjonalnie"
        },
        {
          "id": "adba21ad-362f-4f5b-80be-0df42b70445b",
          "raw": "1 tablespoon neutral oil",
          "name": "olej",
          "quantity": 15,
          "unit": "ml",
          "note": "do ciasta"
        },
        {
          "id": "eaf38314-9e92-4441-9f48-c2193b75732f",
          "raw": "¾ to 1 cup (180 to 240 ml) warm water",
          "name": "woda",
          "quantity": 240,
          "unit": "ml",
          "note": "ciepła"
        },
        {
          "id": "0772e4a8-0355-4dc0-b14f-cd77e8503dd3",
          "raw": "3 to 4 tablespoons (45 ml) melted ghee or oil",
          "name": "ghee",
          "quantity": 45,
          "unit": "ml",
          "note": "roztopione, do warstwowania i smażenia"
        },
        {
          "id": "de39f5a7-698f-4f45-b8b3-49bef7ae0634",
          "raw": "¼ cup flour",
          "name": "mąka pszenna",
          "quantity": 62.5,
          "unit": "ml",
          "note": "do podsypywania"
        }
      ],
      "steps": [
        {
          "id": "47f74744-305c-4982-96db-903681766e0e",
          "text": "W misce wymieszaj mąkę, sól i olej. Stopniowo dolewaj wodę, wyrabiając miękkie, nieklejące się ciasto.",
          "durationMinutes": 5
        },
        {
          "id": "8504e83b-7066-4205-9909-31ec95309a6e",
          "text": "Wyrabiaj ciasto, aż będzie miękkie i elastyczne. Posmaruj je odrobiną oleju, przykryj i odstaw do odpoczęcia.",
          "durationMinutes": 40
        },
        {
          "id": "dfb9633c-cb87-4e3a-92f9-c242040daf67",
          "text": "Podziel ciasto na 8 porcji, uformuj kulki i trzymaj je pod przykryciem.",
          "durationMinutes": 5
        },
        {
          "id": "95931f8e-9eb9-47ac-93fb-bb31963622c7",
          "text": "Rozwałkuj kulkę ciasta na placek, posmaruj odrobiną ghee, posyp szczyptą mąki i złóż w wybrany kształt (trójkąt, kwadrat lub zwiń w rulon i zwiń w ślimaka).",
          "durationMinutes": 5
        },
        {
          "id": "23da5839-6e77-4665-b196-6dbc58715d83",
          "text": "Rozwałkuj ponownie złożone ciasto na placek o grubości odpowiedniej do smażenia.",
          "durationMinutes": 5
        },
        {
          "id": "26ec2b6a-a73d-49d6-ad98-1a6ac37f9178",
          "text": "Rozgrzej patelnię na średnim ogniu. Smaż parathę, obracając ją i smarując ghee z obu stron, aż pojawią się brązowe plamki i chlebek napuchnie.",
          "durationMinutes": 5
        }
      ],
      "warnings": [
        "Przepis został w pełni odczytany ze strony. Ilości zostały przeliczone na system metryczny zgodnie z instrukcją (1 szklanka = 250 ml, 1 łyżka = 15 ml, 1 łyżeczka = 5 ml)."
      ],
      "source": "https://www.indianhealthyrecipes.com/paratha-recipe-plain-paratha/",
      "sourceType": "url",
      "createdAt": "2026-10-03T22:51:33.841Z",
      "updatedAt": "2026-10-03T22:51:33.841Z"
    }
  ],
