  "recipes": [
    {
      "id": "dc097d8b-1cd0-4e44-a1b2-f93bcf6825b7",
      "title": "Keema Matar (Curry z mielonej wołowiny z groszkiem)",
      "description": "Pakistańskie danie jednogarnkowe z mielonej wołowiny i zielonego groszku, pełne aromatycznych przypraw. Jest szybkie w przygotowaniu i doskonale smakuje z naanem lub ryżem.",
      "servings": 4,
      "prepMinutes": 15,
      "cookMinutes": 30,
      "totalMinutes": 45,
      "tags": [
        "pakistańskie",
        "curry",
        "wołowina",
        "jednogarnkowe"
      ],
      "ingredients": [
        {
          "id": "27ee9116-d754-40c4-874d-17a0e9d8d074",
          "raw": "3 tbsp neutral oil, such as grapeseed or avocado",
          "name": "olej",
          "quantity": 45,
          "unit": "ml",
          "note": "neutralny, np. z pestek winogron lub awokado"
        },
        {
          "id": "b35cf2fe-9b42-49c6-9821-4318c0c015ba",
          "raw": "1 tsp cumin seeds",
          "name": "kmin rzymski",
          "quantity": 5,
          "unit": "ml",
          "note": "ziarna"
        },
        {
          "id": "06500853-a62a-4bf3-8a9b-653901d1bf2a",
          "raw": "1 (~220 g) medium onion, finely chopped",
          "name": "cebula",
          "quantity": 220,
          "unit": "g",
          "note": "średnia, drobno posiekana"
        },
        {
          "id": "0b03947c-6e51-47f6-932f-67ec02f101bf",
          "raw": "5-6 garlic cloves, crushed or very finely chopped",
          "name": "czosnek",
          "quantity": 6,
          "unit": "szt",
          "note": "ząbki, przeciśnięte lub drobno posiekane"
        },
        {
          "id": "c82457b2-9ea8-42cf-ba3b-661b01066e89",
          "raw": "1- inch piece ginger, crushed or very finely chopped",
          "name": "imbir",
          "quantity": 1,
          "unit": "szt",
          "note": "kawałek ok. 2,5 cm, starty lub drobno posiekany"
        },
        {
          "id": "542a6ede-2731-4eba-a798-3323bf4b54ab",
          "raw": "1 lb ground beef",
          "name": "wołowina mielona",
          "quantity": 450,
          "unit": "g",
          "note": "ok. 1 funt"
        },
        {
          "id": "f67327ad-e177-4758-bf8f-5f27fc947123",
          "raw": "1 medium (2 small/~250 g) ripe tomato, finely chopped",
          "name": "pomidor",
          "quantity": 250,
          "unit": "g",
          "note": "dojrzały, drobno posiekany"
        },
        {
          "id": "2990fa6b-9f8a-4cec-ab2f-7fe74c446432",
          "raw": "1-2 green chili peppers (such as a small Serrano or Thai chili), chopped",
          "name": "zielona papryczka chili",
          "quantity": 2,
          "unit": "szt",
          "note": "posiekana"
        },
        {
          "id": "1d8e0389-bd18-492b-99ff-87ea988c6294",
          "raw": "1 tbsp plain whole-milk yogurt",
          "name": "jogurt naturalny",
          "quantity": 15,
          "unit": "ml",
          "note": "pełnotłusty"
        },
        {
          "id": "ef1057ef-301f-407c-88ea-cea5d19d3fe7",
          "raw": "1 tsp ground coriander (or coriander powder)",
          "name": "kolendra mielona",
          "quantity": 5,
          "unit": "ml",
          "note": "proszek"
        },
        {
          "id": "90ba8b17-d3ab-4e02-88bb-592b8a9ac9d8",
          "raw": "3/4 tsp mild red chili powder, or to taste",
          "name": "chili w proszku",
          "quantity": 3.75,
          "unit": "ml",
          "note": "łagodne"
        },
        {
          "id": "4a5dd8e8-3053-483a-a956-0cec76ac44fb",
          "raw": "1/2 tsp turmeric powder",
          "name": "kurkuma",
          "quantity": 2.5,
          "unit": "ml",
          "note": "proszek"
        },
        {
          "id": "19f430e7-7f77-4c06-8688-bbf763d61379",
          "raw": "1 1/8 tsp kosher salt, or to taste",
          "name": "sól",
          "quantity": 5.6,
          "unit": "ml",
          "note": "koszerna"
        },
        {
          "id": "041583a3-72f9-4c89-bed7-36827e898e0c",
          "raw": "1 cup (~130 g) frozen green peas, thawed",
          "name": "zielony groszek",
          "quantity": 130,
          "unit": "g",
          "note": "mrożony, rozmrożony"
        },
        {
          "id": "d64b9e5c-0a4f-41b3-a3b9-2a0a23e6cac8",
          "raw": "1 tsp freshly ground black pepper",
          "name": "pieprz czarny",
          "quantity": 5,
          "unit": "ml",
          "note": "świeżo mielony"
        },
        {
          "id": "83be71f9-9582-4374-b1e9-a8c6626bbe5b",
          "raw": "1/4-1/2 tsp garam masala",
          "name": "garam masala",
          "quantity": 2.5,
          "unit": "ml",
          "note": "przyprawa"
        },
        {
          "id": "b8190688-77f6-46ee-a05e-606f9e3986e4",
          "raw": "1/4 cup cilantro leaves, chopped",
          "name": "kolendra świeża",
          "quantity": 60,
          "unit": "ml",
          "note": "liście, posiekane"
        },
        {
          "id": "eb11f5c6-59cb-4cdf-959a-0ef5b02e2412",
          "raw": "1/2 tsp fresh lemon or lime juice",
          "name": "sok z cytryny",
          "quantity": 2.5,
          "unit": "ml",
          "note": "lub z limonki"
        }
      ],
      "steps": [
        {
          "id": "2549f350-6f59-4f51-bec2-bb7d9273dece",
          "text": "Rozgrzej olej na średniej patelni na dużym ogniu. Dodaj kmin rzymski i cebulę, smaż do złotego koloru.",
          "durationMinutes": 8
        },
        {
          "id": "dce6f707-eadc-4454-8bab-5f4874b67c05",
          "text": "Dodaj czosnek i imbir, smaż przez minutę. Dodaj mieloną wołowinę i smaż, często mieszając, aż mięso przestanie być różowe i odparuje wilgoć.",
          "durationMinutes": 5
        },
        {
          "id": "a9bdffe9-0389-4c71-aac1-904def0410da",
          "text": "Dodaj pomidora, zieloną papryczkę chili, jogurt, kolendrę, chili w proszku, kurkumę i sól. Smaż przez 2 minuty, aż pomidory zmiękną. Dodaj 60 ml wody i doprowadź do wrzenia.",
          "durationMinutes": 2
        },
        {
          "id": "8d2b6dc6-302e-4b4c-835e-72962dd55898",
          "text": "Zmniejsz ogień na średni, przykryj i gotuj przez 15 minut, mieszając w połowie czasu. W razie potrzeby dodaj więcej wody, jeśli mięso przywiera.",
          "durationMinutes": 15
        },
        {
          "id": "1f013471-49f6-4d60-ab23-841c395b1fca",
          "text": "Odkryj, wmieszaj groszek i 125 ml wody. Przykryj ponownie i gotuj, aż groszek będzie miękki.",
          "durationMinutes": 4
        },
        {
          "id": "d7ccb260-0729-44fb-9ca7-442e64a2a4b1",
          "text": "Dodaj czarny pieprz, garam masalę i kolendrę, smaż jeszcze chwilę, aż olej zacznie oddzielać się od sosu. Zmniejsz ogień do minimum, przykryj i pozwól smakom się przegryźć.",
          "durationMinutes": 5
        },
        {
          "id": "80431a3a-5358-4af7-8538-d3bf3282117c",
          "text": "Wyłącz ogień, posyp świeżą kolendrą i skrop sokiem z cytryny lub limonki.",
          "durationMinutes": 0
        }
      ],
      "warnings": [
        "Przepis został w pełni odczytany ze strony internetowej."
      ],
      "source": "https://www.teaforturmeric.com/keema-matar/",
      "sourceType": "url",
      "createdAt": "2026-10-03T23:05:34.062Z",
      "updatedAt": "2026-10-03T23:05:34.062Z"
    },
    {
      "id": "4dbf1042-380d-4a0e-bca9-99e30409d2cf",
      "title": "Czosnkowe curry",
      "description": "Aromatyczne danie z kurczaka w kremowym sosie z nerkowców, z wyraźną nutą czosnku i przypraw korzennych.",
      "servings": 4,
      "prepMinutes": 20,
      "cookMinutes": 25,
      "totalMinutes": 45,
      "tags": [
        "kurczak",
        "curry",
        "obiad",
        "kuchnia indyjska"
      ],
      "ingredients": [
        {
          "id": "bc57dc9c-0464-4369-a427-6543163cd483",
          "raw": "400–450 g piersi lub udek z kurczaka",
          "name": "kurczak",
          "quantity": 450,
          "unit": "g",
          "note": "pierś lub udka"
        },
        {
          "id": "1647c096-8811-416c-8de3-c671e470fed2",
          "raw": "70 g nerkowców",
          "name": "nerkowiec",
          "quantity": 70,
          "unit": "g",
          "note": ""
        },
        {
          "id": "203c64e3-c881-46df-81d4-7f82400503c3",
          "raw": "½ małej cebuli",
          "name": "cebula",
          "quantity": 0.5,
          "unit": "szt",
          "note": "mała"
        },
        {
          "id": "40176406-7674-4992-b302-9c68b58e514d",
          "raw": "5–6 ząbków czosnku",
          "name": "czosnek",
          "quantity": 6,
          "unit": "szt",
          "note": ""
        },
        {
          "id": "c5a01bca-1bf0-4d50-b5f9-242deb1520fa",
          "raw": "1 kawałek imbiru, ok. 2–3 cm",
          "name": "imbir",
          "quantity": 3,
          "unit": "cm",
          "note": ""
        },
        {
          "id": "4e0555ff-fb61-4408-b4a7-d4deba7ed243",
          "raw": "150 ml śmietanki 18% lub 30%",
          "name": "śmietanka",
          "quantity": 150,
          "unit": "ml",
          "note": "18% lub 30%"
        },
        {
          "id": "63111ee3-427e-4876-ad13-d09019ca4755",
          "raw": "100–150 ml wody",
          "name": "woda",
          "quantity": 150,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "73a22513-bdad-43d8-bf56-4464e02951f4",
          "raw": "1 łyżka ghee lub masła",
          "name": "masło klarowane",
          "quantity": 15,
          "unit": "ml",
          "note": "ghee lub masło"
        },
        {
          "id": "1145095e-13e1-4a29-a187-07e06bcefdbb",
          "raw": "1 łyżka oleju",
          "name": "olej",
          "quantity": 15,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "adaf2b2e-d10e-4ddf-86d9-f1ca02c200f4",
          "raw": "1 łyżeczka garam masala",
          "name": "garam masala",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "fa7a592c-c952-4424-8984-78d760769008",
          "raw": "1 łyżeczka mielonej kolendry",
          "name": "kolendra mielona",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "1f723044-b6f5-4444-9d06-0a63e5ccac5d",
          "raw": "½ łyżeczki kuminu",
          "name": "kumin",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "1b89cfbd-0374-442a-8fc0-6c54733e2150",
          "raw": "½ łyżeczki kurkumy",
          "name": "kurkuma",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "db6c5c32-e4df-45e2-9bab-187ba57334fb",
          "raw": "½ łyżeczki chili Kashmiri lub zwykłego chili",
          "name": "chili",
          "quantity": 2.5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "9842a2d4-fed3-4e62-9ab9-51ffbb1353ad",
          "raw": "½ łyżeczki soli",
          "name": "sól",
          "quantity": 2.5,
          "unit": "ml",
          "note": "do smaku"
        },
        {
          "id": "540c7e6b-dc75-4bba-9dca-365be3b7cdf0",
          "raw": "1 łyżeczka soku z cytryny",
          "name": "sok z cytryny",
          "quantity": 5,
          "unit": "ml",
          "note": ""
        },
        {
          "id": "39d09e2f-c187-4766-87e7-51fd353afc28",
          "raw": "2–3 strączki kardamonu",
          "name": "kardamon",
          "quantity": 3,
          "unit": "szt",
          "note": "opcjonalnie"
        },
        {
          "id": "357dcb6f-d90c-4f41-9c4f-ca1320202006",
          "raw": "świeża kolendra do podania",
          "name": "kolendra świeża",
          "quantity": 0,
          "unit": "szt",
          "note": "opcjonalnie"
        }
      ],
      "steps": [
        {
          "id": "f92b6ad2-d3d0-4e18-a1a9-89e1d257522e",
          "text": "Zalej nerkowce gorącą wodą i odstaw na 15-20 minut. Odcedź, dodaj 50 ml wody i zblenduj na gładką pastę.",
          "durationMinutes": 20
        },
        {
          "id": "7b645648-c4c9-498c-80c8-ff6b9fd8abe7",
          "text": "Kurczaka pokrój w kawałki, wymieszaj z częścią garam masala, kuminu, solą i olejem. Obsmaż na patelni przez kilka minut i zdejmij na talerz.",
          "durationMinutes": 5
        },
        {
          "id": "4bd3068e-e910-4735-890c-c93d5fd67750",
          "text": "Na tej samej patelni rozgrzej masło i resztę oleju, podsmaż drobno posiekaną cebulę przez 2-3 minuty.",
          "durationMinutes": 3
        },
        {
          "id": "8852f897-22be-46a3-8f3d-9c3e36a728f0",
          "text": "Dodaj starty imbir i większość posiekanego czosnku, smaż 1 minutę.",
          "durationMinutes": 1
        },
        {
          "id": "5766cad7-3fdd-493d-8869-88440b6a0ab0",
          "text": "Dodaj pozostałe przyprawy (kumin, kolendrę, kurkumę, chili, resztę garam masala, kardamon) i smaż 30 sekund.",
          "durationMinutes": 1
        },
        {
          "id": "96ed4438-9d25-4183-b3e1-ae01419066a4",
          "text": "Dodaj pastę z nerkowców i 100 ml wody, wymieszaj. Włóż kurczaka i duś pod przykryciem 8-10 minut.",
          "durationMinutes": 10
        },
        {
          "id": "72296de6-ed66-447a-b104-0b53cb37b581",
          "text": "Dodaj śmietankę oraz ostatni ząbek czosnku (drobno starty), podgrzewaj 2-3 minuty bez gotowania.",
          "durationMinutes": 3
        },
        {
          "id": "9e9efe7d-9e89-4642-b661-99a002fa2d67",
          "text": "Na koniec dodaj sok z cytryny i dopraw solą do smaku.",
          "durationMinutes": 1
        }
      ],
      "warnings": [
        "The recipe is complete and clearly described in the provided image."
      ],
